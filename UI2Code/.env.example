# `true` keeps the visual demo self-contained. Set it to `false` after the
# server is available; all page requests then go through api.js.
VITE_USE_MOCK=false

# Leave empty when using the Vite proxy. In deployment, set an absolute API URL.
VITE_API_BASE_URL=

# Local backend address used only by the Vite development proxy.
VITE_API_PROXY_TARGET=http://localhost:8080
